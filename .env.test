# Incita Backend - Test Environment Variables
# ============================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/incita_test?schema=public"
PORT=3001
NODE_ENV=test
TZ=America/Sao_Paulo

# ============================================
# REDIS
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6380

# ============================================
# AUTHENTICATION (better-auth)
# ============================================
BETTER_AUTH_SECRET=test-secret-key-for-e2e-tests-min-32-chars-long!!
BETTER_AUTH_URL=http://localhost:3001

# ============================================
# AI (not needed for notification tests)
# ============================================
GOOGLE_GENERATIVE_AI_API_KEY=test-key

# ============================================
# STORAGE
# ============================================
STORAGE_DRIVER=r2
STORAGE_APP_FOLDER=incita-test-storage
R2_ACCESS_KEY_ID=test-key
R2_SECRET_ACCESS_KEY=test-secret
R2_BUCKET_NAME=test-bucket
R2_ENDPOINT=https://test.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://test-public.r2.dev

# ============================================
# EMAIL (mailpit-test container)
# ============================================
EMAIL_DRIVER=smtp
EMAIL_FROM=test@example.com
SMTP_HOST=localhost
SMTP_PORT=1025

# ============================================
# LOGGER
# ============================================
LOGGER_EMAIL_ENABLED=false
