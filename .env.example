# Incita Backend - Environment Variables

# ============================================
# BASE CONFIG
# ============================================
DATABASE_URL="postgresql://user:password@localhost:5432/incita?schema=public"
PORT=3000
NODE_ENV=development
TZ=America/Sao_Paulo
# API_URL=https://api.example.com       # Production API URL (used in OpenAPI docs)

# ============================================
# REDIS
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_USERNAME=              # Optional
# REDIS_PASSWORD=              # Optional

# ============================================
# AUTHENTICATION (better-auth)
# ============================================
BETTER_AUTH_SECRET=your-super-secret-key-here
BETTER_AUTH_URL=http://localhost:3000

# Authentication - Social OAuth (Optional)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# ============================================
# AI (Vercel AI SDK - Google)
# ============================================
GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-api-key

# AI Model Configuration
# AI_PRIMARY_MODEL_NAME=gemini-3-flash-preview
# AI_PRIMARY_MODEL_RPM=15                  # Requests per minute
# AI_PRIMARY_MODEL_RPD=1500                # Requests per day
# AI_FALLBACK_MODEL_NAME=gemini-2.5-pro
# AI_FALLBACK_MODEL_RPM=5                  # Requests per minute
# AI_FALLBACK_MODEL_RPD=500                # Requests per day
# AI_MODEL_UNAVAILABLE_TIMEOUT_SECS=60     # Seconds to mark model unavailable after 503

# ============================================
# OBJECT STORAGE
# ============================================
STORAGE_DRIVER=local
STORAGE_APP_FOLDER=incita-storage
# STORAGE_CLEANUP_CRON="0 */2 * * *"   # Optional - cron for cleanup job

# R2 Storage (Required if STORAGE_DRIVER === 'r2')
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-key
# R2_REGION=auto
# R2_BUCKET_NAME=your-bucket-name
# R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# R2_PUBLIC_URL=https://your-public-url

# Dropbox Storage (Required if STORAGE_DRIVER === 'dropbox')
# DROPBOX_CLIENT_ID=your-dropbox-client-id
# DROPBOX_CLIENT_SECRET=your-dropbox-client-secret
# DROPBOX_REFRESH_TOKEN=your-dropbox-refresh-token

# Cloudinary Storage (Required if STORAGE_DRIVER === 'cloudinary')
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# ============================================
# EMAIL
# ============================================
# Driver: 'smtp' or 'mailjet' (default: smtp)
EMAIL_DRIVER=smtp
EMAIL_FROM=noreply@example.com

# SMTP Configuration (Required if EMAIL_DRIVER='smtp')
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# SMTP_USER=your-email-user           # Optional auth
# SMTP_PASS=your-email-password       # Optional auth

# Mailjet API Configuration (Required if EMAIL_DRIVER='mailjet')
# MAILJET_API_KEY=your-mailjet-api-key
# MAILJET_SECRET_KEY=your-mailjet-secret-key

# ============================================
# LOGGER EMAIL NOTIFICATIONS (Optional)
# ============================================
LOGGER_EMAIL_ENABLED=false
# LOGGER_EMAIL_LEVEL=error
# LOGGER_EMAIL_RECIPIENTS=admin@example.com,dev@example.com
# LOGGER_EMAIL_BATCH_INTERVAL_MS=300000

# ============================================
# ADMIN SETUP (Optional)
# ============================================
ADMIN_SETUP=false
ADMIN_NAME=Admin
ADMIN_EMAIL=your@gmail.com
ADMIN_PASSWORD=S3cureP4ssw0rd
