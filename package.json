    "@types/node": "^22.10.7",
    "@types/node-fetch": "^2.6.13",
    "@types/nodemailer": "^7.0.5",
    "@types/pug": "^2.0.10",
    "@types/streamifier": "^0.1.2",
    "@types/supertest": "^7.2.0",
