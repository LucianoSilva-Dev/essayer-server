    "express": "5.2.1",
    "ioredis": "^5.7.0",
    "mime-types": "^3.0.2",
    "multer": "^2.1.1",
    "nestjs-better-auth": "^0.6.4",
    "nestjs-zod": "^5.0.1",
    "node-fetch": "^2.7.0",
