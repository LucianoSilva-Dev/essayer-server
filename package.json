{
  "name": "incita-backend",
  "version": "2.0.0",
  "description": "Backend API for Incita platform - NestJS/Prisma",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start --env-file .env",
    "start:dev": "nest start --watch --env-file .env",
    "start:debug": "nest start --debug --watch --env-file .env",
    "start:prod": "node dist/main",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest run --watch",
    "test:e2e": "bash scripts/test-e2e.sh",
    "test:e2e:watch": "bash scripts/test-e2e.sh --watch"
  },
  "dependencies": {
