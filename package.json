    "@nestjs/schedule": "^6.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.6.0",
    "@scalar/nestjs-api-reference": "^1.0.3",
