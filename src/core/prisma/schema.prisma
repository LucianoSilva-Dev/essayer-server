// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum RequestStatus {
  APPROVED
  REFUSED
}

enum RepertoireType {
  ARTICLE
  CITATION
  WORK
}

enum WorkType {
  BOOK
  FILM
  MUSIC
  PLAY
}

enum ActivityType {
  ESSAY
}

enum AIResponseStatus {
  FINISHED
  PENDING
  ERROR
}

enum NotificationType {
  ACTIVITY_SENT
  ACTIVITY_CLOSED
  ACTIVITY_CORRECTED
  TEACHER_REQUEST_STATUS
}

// ============================================
// BETTER AUTH ENTITIES
// ============================================

model User {
  id            String    @id @default(uuid(7))
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  imageFileId   String? // ID to locate the image file in the storage provider
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String?   @default("student")
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  lattes        String?
  sessions      Session[]
  accounts      Account[]

  // Domain relations
  teacherRequests         TeacherRequest[]  @relation("requester")
  teacherRequestsReviewed TeacherRequest[]  @relation("reviewer")
  comments                Comment[]
  repertoiresCreated      Repertoire[]      @relation("creator")
  repertoiresLiked        Repertoire[]      @relation("like")
  repertoiresFavourited   Repertoire[]      @relation("favourite")
  classesCreated          Class[]           @relation("creator")
  classesPending          Class[]           @relation("pending")
  classesMember           Class[]           @relation("member")
  essayResponses          EssayResponse[]
  userEssays              UserEssay[]
  notificationsSent       Notification[]    @relation("sender")
  notificationsSeen       Notification[]    @relation("seen")
  integrationMappings     IntegrationUser[]
  legalDocumentAcceptances LegalDocumentAcceptance[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id @default(uuid(7))
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid(7))
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid(7))
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ============================================
// DOMAIN ENTITIES
// ============================================

model TeacherRequest {
  id        String         @id @default(uuid(7))
  lattes    String
  status    RequestStatus?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  hookUrl   String?

  notification TeacherRequestStatusNotification?
  user         User                              @relation("requester", fields: [userId], references: [id])
  userId       String
  reviewer     User?                             @relation("reviewer", fields: [reviewerId], references: [id])
  reviewerId   String?
}

model Comment {
  id        String   @id @default(uuid(7))
  text      String
  fixed     Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  repertoire   Repertoire @relation(fields: [repertoireId], references: [id])
  repertoireId String
  user         User       @relation(fields: [userId], references: [id])
  userId       String
}

model Repertoire {
  id        String         @id @default(uuid(7))
  author    String
  topics    String[]
  subtopics String[]
  type      RepertoireType
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  essays     Essay[]
  article    Article?
  citation   Citation?
  work       Work?
  comments   Comment[]
  creator    User      @relation("creator", fields: [creatorId], references: [id])
  creatorId  String
  likes      User[]    @relation("like")
  favourites User[]    @relation("favourite")
}

model Article {
  id       String  @id @default(uuid(7))
  title    String
  abstract String
  source   String?

  repertoire   Repertoire @relation(fields: [repertoireId], references: [id])
  repertoireId String     @unique
}

model Citation {
  id     String  @id @default(uuid(7))
  quote  String
  source String?

  repertoire   Repertoire @relation(fields: [repertoireId], references: [id])
  repertoireId String     @unique
}

model Work {
  id       String   @id @default(uuid(7))
  title    String
  synopsis String
  type     WorkType

  repertoire   Repertoire @relation(fields: [repertoireId], references: [id])
  repertoireId String     @unique
}

model Class {
  id        String   @id @default(uuid(7))
  name      String
  iconId    String   @default("none")
  school    String?
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities     Activity[]
  creator        User       @relation("creator", fields: [creatorId], references: [id])
  creatorId      String
  pendingMembers User[]     @relation("pending")
  members        User[]     @relation("member")
}

model Activity {
  id          String       @id @default(uuid(7))
  title       String
  description String
  deadline    DateTime?
  type        ActivityType
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  essay                 Essay?
  class                 Class                  @relation(fields: [classId], references: [id])
  classId               String
  activityNotifications ActivityNotification[]
}

model EssayFeedback {
  id         String   @id @default(uuid(7))
  gradeC1    Int
  gradeC2    Int
  gradeC3    Int
  gradeC4    Int
  gradeC5    Int
  feedbackC1 String
  feedbackC2 String
  feedbackC3 String
  feedbackC4 String
  feedbackC5 String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  aiCorrection      AICorrection?
  teacherCorrection TeacherCorrection?
}

model TeacherCorrection {
  id   String  @id @default(uuid(7))
  seen Boolean @default(false)

  response   EssayResponse @relation(fields: [responseId], references: [id])
  responseId String        @unique
  feedback   EssayFeedback @relation(fields: [feedbackId], references: [id])
  feedbackId String        @unique
}

model AICorrection {
  id        String           @id @default(uuid(7))
  text      String
  status    AIResponseStatus
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  essay      UserEssay     @relation(fields: [essayId], references: [id])
  essayId    String
  feedback   EssayFeedback @relation(fields: [feedbackId], references: [id])
  feedbackId String        @unique
}

model EssayResponse {
  id         String    @id @default(uuid(7))
  answerDate DateTime?
  text       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  essay     Essay              @relation(fields: [essayId], references: [id])
  essayId   String
  feedback  TeacherCorrection?
  student   User               @relation(fields: [studentId], references: [id])
  studentId String
}

model Essay {
  id                 String @id @default(uuid(7))
  theme              String
  timeLimitInMinutes Float?

  responses   EssayResponse[]
  repertoires Repertoire[]
  activity    Activity        @relation(fields: [activityId], references: [id])
  activityId  String          @unique
}

model UserEssay {
  id        String   @id @default(uuid(7))
  theme     String
  text      String?
  duration  Float?
  date      DateTime
  finished  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aiCorrections AICorrection[]
  student       User           @relation(fields: [studentId], references: [id])
  studentId     String
}

model Notification {
  id        String           @id @default(uuid(7))
  type      NotificationType
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  activityNotification ActivityNotification?
  teacherRequestStatus TeacherRequestStatusNotification?
  senders              User[]                            @relation("sender")
  seenBy               User[]                            @relation("seen")
}

model TeacherRequestStatusNotification {
  id     String  @id @default(uuid(7))
  motivo String?

  teacherRequest   TeacherRequest @relation(fields: [teacherRequestId], references: [id])
  teacherRequestId String         @unique
  notification     Notification   @relation(fields: [notificationId], references: [id])
  notificationId   String         @unique
}

model ActivityNotification {
  id             String @id @default(uuid(7))
  activityId     String
  notificationId String @unique

  activity     Activity     @relation(fields: [activityId], references: [id])
  notification Notification @relation(fields: [notificationId], references: [id])
}

// ============================================
// API KEY (better-auth plugin)
// ============================================

model Apikey {
  id                  String    @id @default(uuid(7))
  configId            String    @default("default")
  name                String?
  start               String?
  referenceId         String
  prefix              String?
  key                 String
  refillInterval      Int?
  refillAmount        Int?
  lastRefillAt        DateTime?
  enabled             Boolean?  @default(true)
  rateLimitEnabled    Boolean?  @default(true)
  rateLimitTimeWindow Int?      @default(86400000)
  rateLimitMax        Int?      @default(10)
  requestCount        Int?      @default(0)
  remaining           Int?
  lastRequest         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  permissions         String?
  metadata            String?

  @@index([configId])
  @@index([referenceId])
  @@index([key])
  @@map("apikey")
}

// ============================================
// INTEGRATION USER MAPPING
// ============================================

model IntegrationUser {
  id              String   @id @default(uuid(7))
  integrationName String
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalUserId  String
  externalRole    String   @default("student")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([integrationName, externalUserId])
  @@index([userId])
  @@index([externalUserId])
  @@map("integration_user")
}

// ============================================
// LEGAL DOCUMENT ACCEPTANCE (LGPD)
// ============================================

enum LegalDocumentType {
  TERMS_OF_USE
}

model LegalDocumentAcceptance {
  id           String             @id @default(uuid(7))
  userId       String
  documentType LegalDocumentType
  version      String
  acceptedAt   DateTime           @default(now())
  ipAddress    String?
  userAgent    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, documentType, version])
  @@index([userId])
  @@index([documentType, version])
  @@map("legal_document_acceptance")
}
