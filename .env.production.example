# Public API URL used in docs/auth callbacks
API_URL=https://api.example.com
BETTER_AUTH_URL=https://api.example.com

# Runtime
NODE_ENV=production
PORT=3000
TZ=America/Sao_Paulo
SERVER_NAME=api.example.com
NGINX_HTTP_PORT=8080
CLIENT_MAX_BODY_SIZE=25m
API_IMAGE=ghcr.io/lucianosilva-dev/essayer-server
API_IMAGE_TAG=latest

# Browser clients
# Comma-separated. Example:
# CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=

# Postgres externo
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Redis local na VPS
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# Auth
BETTER_AUTH_SECRET=change-me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI
GOOGLE_GENERATIVE_AI_API_KEY=
AI_PRIMARY_MODEL_NAME=gemini-3-flash-preview
AI_PRIMARY_MODEL_RPM=15
AI_PRIMARY_MODEL_RPD=1500
AI_FALLBACK_MODEL_NAME=gemini-2.5-pro
AI_FALLBACK_MODEL_RPM=5
AI_FALLBACK_MODEL_RPD=500
AI_MODEL_UNAVAILABLE_TIMEOUT_SECS=60

# Storage
STORAGE_DRIVER=r2
STORAGE_APP_FOLDER=incita-storage
STORAGE_CLEANUP_CRON=*/2 * * * *

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_URL=

DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
DROPBOX_REFRESH_TOKEN=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email
EMAIL_DRIVER=smtp
EMAIL_FROM=noreply@example.com

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

MAILJET_API_KEY=
MAILJET_SECRET_KEY=

# Logger email notifications
LOGGER_EMAIL_ENABLED=false
LOGGER_EMAIL_LEVEL=error
LOGGER_EMAIL_RECIPIENTS=
LOGGER_EMAIL_BATCH_INTERVAL_MS=300000

# Integration
ANGLO_SYNC_SECRET=

# Admin bootstrap opcional
ADMIN_SETUP=false
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
